    "Open Login Items" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz ustawienia logowania"
          }
        }
      }
    },
    "Protects the preferred microphone during device connect and disconnect, and treats switches you make in System Settings as intentional. Turn it off to lock the input to one device." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chroni preferowany mikrofon podczas podłączania i odłączania urządzeń, a zmiany wprowadzone w Ustawieniach systemowych traktuje jako zamierzone. Wyłącz, aby zablokować wejście na jednym urządzeniu."
          }
        }
      }
    },
    "Quit MicGuard" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończ MicGuard"
